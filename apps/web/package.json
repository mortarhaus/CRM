{
  "name": "@crm/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-node.mjs",
    "build:node": "node scripts/build-node.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:gates": "vitest run --config vitest.gates.config.mts",
    "auth:generate": "auth generate --config src/lib/auth/cli-config.ts --output src/db/schema/auth.ts --yes && tsx scripts/postprocess-auth-schema.ts src/db/schema/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap": "tsx --env-file=../../.env scripts/bootstrap-roles.ts",
    "db:migrate": "tsx --env-file=../../.env migrate.ts",
    "smoke:auth-route": "tsx scripts/smoke-auth-route.ts",
    "test:e2e": "playwright test",
    "worker:dev": "tsx --env-file=../../.env worker.ts",
    "jobs:retry": "tsx --env-file=../../.env scripts/retry-job.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@crm/core": "workspace:*",
    "@next/env": "16.4.2",
    "@node-rs/argon2": "2.2.1",
    "@react-email/render": "2.1.1",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.66.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "pg-boss": "12.35.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "otpauth": "9.5.2",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
