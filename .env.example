# Copy to .env (git-ignored) and set every value. Never commit .env.

# saas | selfhost
DEPLOYMENT_MODE=selfhost

# Public URL of the web app (Better Auth base URL and trusted origin).
# Production must use https://; only localhost, 127.0.0.1 and [::1] may use http.
APP_URL=http://localhost:3000

# At least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=

# The one header the edge in front of the web app sets to the client address (rate-limit keys and the audit IP).
# Required in production: cf-connecting-ip (own SaaS, behind the Cloudflare Tunnel) or x-forwarded-for (self-host
# behind Caddy, which must overwrite, not append to, the caller's value). Unset or none (dev without an edge): every
# request shares one placeholder address, so the IP limits are deployment-wide. docker/compose.dev.yml sets it for
# the web container. See docs/runbooks/phase-1-security.md.
# TRUSTED_CLIENT_IP_HEADER=none

# Host-side URLs for `pnpm dev`, `pnpm db:migrate` and `pnpm worker:dev` against the compose Postgres on
# 127.0.0.1:5433, one database role each (docs/runbooks/phase-1-database-roles.md). docker/compose.dev.yml
# overrides them inside containers. The passwords are the fixed dev-only values of the compose file.
# DATABASE_URL (crm_app) may go through a transaction-mode pooler. DATABASE_MIGRATOR_URL (crm_migrator) must
# be a DIRECT connection, never pooled: the migration runner holds a session-level advisory lock.
# DATABASE_WORKER_URL (crm_worker) is read by the worker only.
DATABASE_URL=postgres://crm_app:crm-app-dev-only@localhost:5433/crm
DATABASE_MIGRATOR_URL=postgres://crm_migrator:crm-migrator-dev-only@localhost:5433/crm
DATABASE_WORKER_URL=postgres://crm_worker:crm-worker-dev-only@localhost:5433/crm

# `pnpm db:bootstrap` creates or repairs the five roles (once per cluster, before migrations).
# Dev only; production passwords come from the host's secret store (UNI-08). Each password has at least
# 16 characters. CRM_PURGE_PASSWORD stays unset until the purge job lands (Phase 9).
# DATABASE_ADMIN_URL=postgres://postgres:postgres-dev-only@localhost:5433/crm
# CRM_MIGRATOR_PASSWORD=crm-migrator-dev-only
# CRM_APP_PASSWORD=crm-app-dev-only
# CRM_WORKER_PASSWORD=crm-worker-dev-only
